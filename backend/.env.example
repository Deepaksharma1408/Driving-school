# Core Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drivinity_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=drivinity_db

# Security Configuration (REQUIRED)
JWT_SECRET=drivinity_jwt_secret_key_2026_super_secure_production

# Transactional Email Provider (Brevo / Sendinblue)
BREVO_API_KEY=xkeysib-your_brevo_v3_api_key_here
BREVO_SENDER_EMAIL=contact@drivinity.com

# SMS Notification Provider (Twilio)
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+61400000000
